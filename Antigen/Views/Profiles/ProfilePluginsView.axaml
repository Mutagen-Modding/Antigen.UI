<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:profiles="clr-namespace:Antigen.ViewModels.Profiles"
             mc:Ignorable="d"
             d:DesignWidth="700"
             d:DesignHeight="360"
             x:Class="Antigen.Views.Profiles.ProfilePluginsView"
             x:DataType="profiles:ProfilePluginsVM">
    <UserControl.Styles>
        <Style Selector="TextBlock.disabledPlugin">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.columnHeader">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto,Auto"
              Margin="0,0,0,8">
            <TextBox Grid.Column="0"
                     MaxWidth="280"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     Theme="{StaticResource SearchTextBox}"
                     Text="{Binding FilterText, Delay=150}"
                     PlaceholderText="Filter plugins..." />

            <CheckBox Grid.Column="1"
                      Margin="12,0"
                      VerticalAlignment="Center"
                      IsChecked="{Binding FollowLoadOrder}"
                      ToolTip.Tip="Mirror the enabled flags from plugins.txt instead of picking manually"
                      Content="Follow load order" />

            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Text="{Binding SelectionSummary}" />
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="36,32,*,90,100"
              Margin="8,0,20,4">
            <TextBlock Grid.Column="0" Classes="columnHeader" Text="#" />
            <TextBlock Grid.Column="2" Classes="columnHeader" Text="PLUGIN" />
            <TextBlock Grid.Column="3" Classes="columnHeader" TextAlignment="Right" Text="SIZE" />
            <TextBlock Grid.Column="4" Classes="columnHeader" TextAlignment="Right" Text="RECORDS" />
        </Grid>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding FilteredEntries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="profiles:PluginEntryVM">
                        <Border Theme="{StaticResource ListRowBorder}"
                                Margin="0,1,12,1"
                                Padding="8,4">
                            <Grid ColumnDefinitions="36,32,*,90,100">
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontFamily="monospace"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="{Binding Index}" />

                                <CheckBox Grid.Column="1"
                                          VerticalAlignment="Center"
                                          MinWidth="0"
                                          IsChecked="{Binding Enabled}"
                                          IsEnabled="{Binding CanToggle}" />

                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Classes.disabledPlugin="{Binding !Enabled}"
                                           Text="{Binding FileName}" />

                                <TextBlock Grid.Column="3"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding SizeText}" />

                                <TextBlock Grid.Column="4"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding RecordCountText}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
